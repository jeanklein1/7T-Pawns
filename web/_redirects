# WEBSITE_1 — the speakable aliases. Canonical paths are /, /about/ and
# /collection/; these exist to be said aloud and printed on a wall.
# 302, deliberately: a browser never burns an alias in, so an alias can
# move the day the site does.
/main    /about/   302
/main/   /about/   302
/world   /         302
/world/  /         302

# DOORS_4 — /text/ retired into /writings/. 301, unlike the aliases
# above: this path is not moving again, and burning it in is the point.
/text     /writings/   301
/text/    /writings/   301
